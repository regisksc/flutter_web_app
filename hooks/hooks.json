{
  "PreToolUse": [
    {
      "matcher": "Bash|bash|Edit|edit|Write|write|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PROJECT_DIR}/hooks/pre_tool_guard.sh",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PROJECT_DIR}/hooks/stop_gate.sh",
          "timeout": 10
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PROJECT_DIR}/hooks/session_start.sh",
          "timeout": 10
        }
      ]
    }
  ]
}
